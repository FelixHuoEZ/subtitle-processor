{
  "manifest_version": 3,
  "name": "Subtitle Processor",
  "version": "1.2",
  "description": "Send the current YouTube page to Subtitle Processor",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/",
    "https://*/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": [
        "youtube-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
