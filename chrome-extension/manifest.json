{
  "manifest_version": 3,
  "name": "Subtitle Processor",
  "version": "1.6",
  "description": "Send the current YouTube page to Subtitle Processor",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://readwise.gauss.surf/*",
    "https://readwise-api.gauss.surf/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": [
        "youtube-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
