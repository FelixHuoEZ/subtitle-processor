# Docker image overrides
# 如需从私有镜像仓库拉取，填入镜像地址；否则留空使用默认本地镜像
# SUBTITLE_PROCESSOR_IMAGE=10.0.0.1:5443/subtitle/subtitle-processor:latest
# TRANSCRIBE_AUDIO_IMAGE=10.0.0.1:5443/subtitle/transcribe-audio:latest
# TELEGRAM_BOT_IMAGE=10.0.0.1:5443/subtitle/telegram-bot:latest
# 调整字幕处理 API 的连接/读取超时（秒）
# SUBTITLE_CONNECT_TIMEOUT=120
# SUBTITLE_READ_TIMEOUT=1800
# 首次 Telegram 心跳的启动宽限期；超时后健康检查返回 unhealthy
# TELEGRAM_HEARTBEAT_STARTUP_GRACE_SECONDS=300
# 转录重试/超时设置（subtitle-processor）
# TRANSCRIBE_MAX_RETRIES=5
# TRANSCRIBE_TIMEOUT_MIN=300
# TRANSCRIBE_TIMEOUT_MAX=1800
# TRANSCRIBE_TIMEOUT_FACTOR=1.5
# 音频语言探测 provider（与字幕文本翻译 provider 独立）
# AUDIO_PROBE_PROVIDERS=configured_funasr
# AUDIO_PROBE_MIN_CONFIDENCE=0.58
# 下载并发/重试设置（subtitle-processor）
# DOWNLOAD_CONCURRENCY=2
# DOWNLOAD_MAX_RETRIES=3
# DOWNLOAD_RETRY_BASE_DELAY=2
# DOWNLOAD_RETRY_BACKOFF=2
# DOWNLOAD_RETRY_MAX_DELAY=30
# DOWNLOAD_TOTAL_TIMEOUT_SECONDS=180
# DOWNLOAD_SOCKET_TIMEOUT_SECONDS=30
# 持久化匿名运行指标，用于每日下载/队列/重启趋势审视
# RUNTIME_METRICS_ENABLED=true
# RUNTIME_METRICS_MAX_EVENTS=50000
# Cloudflare Access source verification. Enable only after both Access apps and
# INTERNAL_SERVICE_TOKEN are configured. Multiple AUD tags are comma-separated.
# ACCESS_AUTH_ENABLED=false
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# ACCESS_WEB_APPLICATION_AUD=web-application-aud
# ACCESS_API_APPLICATION_AUD=api-application-aud
# ACCESS_ALLOWED_ORIGINS=https://readwise.gauss.surf
# INTERNAL_SERVICE_TOKEN=generate-a-long-random-value
# 服务重启后，为尚未产生 Readwise 外部副作用的中断任务创建关联续跑任务
# AUTO_RETRY_INTERRUPTED_TASKS=false
# AUTO_RETRY_INTERRUPTED_MAX_ATTEMPTS=3
# AUTO_RETRY_INTERRUPTED_DELAY_SECONDS=5
# 转录并发限制（默认不限）
# TRANSCRIBE_CONCURRENCY=
# 检测到原始中文字幕轨时直接剪藏 URL 到 Readwise；不满足条件仍下载字幕或转录
# READWISE_URL_ONLY_WHEN_ZH_SUBS=true
# 自动把非目标语言字幕翻译到指定语言；默认关闭
# AUTO_TRANSLATE_NON_TARGET_LANGUAGE=false
# AUTO_TRANSLATE_TARGET_LANGUAGE=zh
# AUTO_TRANSLATE_MIN_SOURCE_CONFIDENCE=0.75
# 日志级别和完整内容调试；默认不记录完整字幕/转录正文
# LOG_LEVEL=INFO
# DEBUG_CONTENT_LOGGING=false
