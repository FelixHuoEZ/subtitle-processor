# Application Configuration
app:
  name: "Subtitle Processor"
  version: "2.0.0"
  secret_key: "replace-with-secure-secret"
  debug: false
  max_file_size: 524288000  # 500MB in bytes
  upload_folder: "/app/uploads"
  output_folder: "/app/outputs"

# Storage Settings
storage:
  backend: json  # json/redis
  redis:
    url: redis://redis:6379/0
    key_prefix: subtitle_processor
    # ttl_seconds: 0

# API Tokens
tokens:
  readwise:
    api_token: your_readwise_token_here
  telegram: your_telegram_bot_token_here
  deepl:
    api_key: your_deepl_token_here
    base_url: https://api-free.deepl.com/v2
  openai:
    - name: default
      api_key: your_openai_api_key_here
      api_endpoint: https://api.openai.com/v1/chat/completions
      model: gpt-4o-mini
      prompt: "Translate the following subtitle text to {target_lang}. Return only the translation."

# Audio Language Probe Settings
# This credential is intentionally separate from text-translation providers.
audio_probe:
  providers:
    - configured_funasr
    # - openai
  min_confidence: 0.58
  openai:
    api_key: ""
    base_url: https://api.openai.com/v1
    model: whisper-1
    timeout: 120

# Server Configuration
servers:
  domain: http://your.domain.com
  # video_domain: http://video.domain.com
  # Optional DeepLX server used by manual subtitle translation.
  deeplx: http://deeplx:1188
  transcribe:
    default_url: http://transcribe-audio:10095
    timeout: 300
    balance_mode: priority # priority/weight/round_robin
    servers:
      - name: server1
        url: http://server1.example.com:10095
        priority: 1
        description: Example Server 1
      - name: server2
        url: http://server2.example.com:10095
        priority: 2
        description: Example Server 2

# Telegram webhook configuration
telegram:
  webhook:
    enabled: true
    listen: 0.0.0.0
    port: 8082
    path: /telegram/webhook
    public_url: https://subtitle-telegram-bot.example.com/telegram/webhook
    drop_pending_updates: true
    # secret_token: change_me
  prompt_flow:
    require_location: true
    require_tags: true
    require_hotwords: true
    tags_timeout_seconds: 180
    hotwords_timeout_seconds: 180

# Translation Settings
translation:
  default_target_language: zh
  max_retries: 3
  base_delay: 3
  chunk_size: 2000
  min_chunk_size: 1600
  max_chunk_size: 2400
  request_interval: 1.0
  request_timeout: 60
  deeplx_health_timeout: 2
  deeplx_cooldown_seconds: 300
  services:
    - name: deepl_api
      enabled: true
      priority: 1
    - name: openai_default
      config_name: default
      enabled: true
      priority: 2
    - name: deeplx
      enabled: false
      priority: 90
